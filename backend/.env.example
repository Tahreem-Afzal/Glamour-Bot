# Copy this file to ".env" (same folder) and fill in your real keys.

# Try-on (FASHN) — https://app.fashn.ai -> Developer API -> API Keys
FASHN_API_KEY=paste_your_fashn_api_key_here

# Image generation (Stability AI) — https://platform.stability.ai/account/keys
STABILITY_API_KEY=paste_your_stability_api_key_here

# Chatbot + prompt enhancement (Groq) — https://console.groq.com/keys
GROQ_API_KEY=paste_your_groq_api_key_here

# Optional — only change if you want a different DB location/engine
DATABASE_URL=sqlite:///./tryon.db
